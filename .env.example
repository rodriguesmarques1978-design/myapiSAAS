# Supabase — Dashboard → Project Settings → API
# URL do projeto. Público, usado pelos clients de auth (browser e server).
NEXT_PUBLIC_SUPABASE_URL=
# Anon key (publishable). Sujeita a RLS, pode ir para o bundle do browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: ignora RLS, só pode ser usada server-side. Nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — Console → Database → REST API
# Usado para rate limiting. Só server-side, nunca expor no browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

